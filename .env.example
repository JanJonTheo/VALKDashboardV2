# Browser-facing origin and signed HttpOnly legacy-login session
VALK_PUBLIC_URL=http://167.235.65.113:8889
VALK_SESSION_SECRET=replace-with-at-least-32-random-characters
# Use false only while the dashboard is intentionally served over plain HTTP.
VALK_COOKIE_SECURE=false

# Existing Flask API, multi-tenant configuration and Streamlit branding assets
FLASK_API_BASE_URL=http://127.0.0.1:5000/api/
FLASK_API_VERSION=1.8.0
VALK_TENANT_FILE=/home/valk/valk/tenant.json
VALK_TENANT_DB_ROOT=/home/valk
VALK_TENANT_LOGO_DIR=/home/valk/streamlit/assets

# Optional future bearer-token integration. Omit to use each tenant's legacy API key server-side.
DASHBOARD_JWT_SECRET=
BETTER_AUTH_SECRET=
VALK_SOCIAL_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Local development only. Never enable in production.
VALK_DEMO_MODE=false
VALK_DEMO_ROLE=admin
